# Docker Compose configuration for local demonstration.
CITYMATE_DEMO=true
# Set true when serving the frontend over HTTPS.
CITYMATE_COOKIE_SECURE=false
CITYMATE_CACHE_MODE=mutex
CITYMATE_MYSQL_PASSWORD=citymate-local-only
CITYMATE_MYSQL_ROOT_PASSWORD=citymate-root-local-only
# Optional model, never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# Enable these together for the optional Chroma + MCP retrieval path.
CITYMATE_AI_EXTRAS=false
CITYMATE_KNOWLEDGE_MODE=lexical
CITYMATE_KNOWLEDGE_TRANSPORT=local
# Unicode characters, not tokens. Overlap only applies within long paragraphs.
CITYMATE_KNOWLEDGE_CHUNK_SIZE=320
CITYMATE_KNOWLEDGE_CHUNK_OVERLAP=48
