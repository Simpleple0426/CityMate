# CoursePilot 环境变量示例

# OpenAI 官方：BASE_URL 留空。
# OpenAI-compatible 服务：填写对应的 BASE_URL 和模型名。
OPENAI_API_KEY=your_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 仅在服务商支持 enable_thinking 时设置 true/false；留空不发送该参数。
COURSEPILOT_ENABLE_THINKING=

APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

REDIS_PASSWORD=coursepilot123
REDIS_URL=redis://:coursepilot123@redis:6379/0

CHROMA_HOST=chromadb
CHROMA_PORT=8000
COURSEPILOT_KNOWLEDGE_TRANSPORT=mcp
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

COURSEPILOT_SKILLS_DIR=/app/skills
EVAL_BASELINE_PATH=/app/data/eval/baseline.json

PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
