# Copy to backend/.env for manual local development. Real values stay untracked.
CITYMATE_DATABASE_URL=sqlite:///./citymate.sqlite3
CITYMATE_REDIS_URL=redis://127.0.0.1:16379/0
CITYMATE_DEMO=true
CITYMATE_COOKIE_SECURE=false
CITYMATE_CACHE_MODE=mutex
CITYMATE_UPLOADS=./data/citymate/uploads

# Optional model and policy retrieval.
CITYMATE_MODEL_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
CITYMATE_KNOWLEDGE_MODE=lexical
CITYMATE_KNOWLEDGE_TRANSPORT=local
CITYMATE_KNOWLEDGE_CHUNK_SIZE=320
CITYMATE_KNOWLEDGE_CHUNK_OVERLAP=48
CITYMATE_CHROMA_PATH=./data/citymate/chroma
