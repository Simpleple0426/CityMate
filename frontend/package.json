{
  "name": "citymate-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests vite.config.js index.html package.json .prettierrc.json",
    "format:check": "prettier --check src tests vite.config.js index.html package.json .prettierrc.json"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "markdown-it": "^15.0.3",
    "vite": "^7.2.7",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
